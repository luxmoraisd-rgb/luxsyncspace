DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CLIENT_URL=http://localhost:5173
# Production example: CLIENT_URLS=https://your-app.vercel.app,https://app.yourdomain.com
CLIENT_URLS=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false
# Required for reliable Socket.IO rooms across multiple Vercel Function instances.
REDIS_URL=rediss://default:password@your-upstash-host:6379
APP_NAME=LuxSyncspace
APP_URL=http://localhost:5173
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=465
SMTP_USER=emailapikey
SMTP_PASSWORD=your-zeptomail-smtp-token
SMTP_FROM_EMAIL=Luxmor.syncspace@luxmorai.com
ADMIN_EMAIL=Luxmor@syncspace.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Shared secret and organization UUID used only by the HRMS-to-Outlook provisioning call.
HRMS_PROVISIONING_TOKEN=replace-with-a-long-random-shared-token
HRMS_PROVISIONING_ORGANIZATION_ID=your-outlook-organization-uuid
# Optional: enables flexible natural-language planning for the administrator AI agent.
# Without a key, the agent still supports its documented built-in command patterns.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional HRMS connector. Use the HRMS backend base URL and the same secret as CENTRAL_AGENT_TOKEN there.
HRMS_AGENT_URL=https://your-hrms-api.example.com
HRMS_AGENT_TOKEN=replace-with-a-long-random-shared-token
VAPID_PUBLIC_KEY=your-web-push-public-key
VAPID_PRIVATE_KEY=your-web-push-private-key
VAPID_SUBJECT=mailto:Luxmor.syncspace@luxmorai.com
# Replace with your own STUN/TURN servers for production reliability.
WEBRTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# Set these in the Vercel frontend project (do not add them to the server environment):
# VITE_API_URL=https://your-realtime-api.example.com/api
# VITE_SOCKET_URL=https://your-realtime-api.example.com
